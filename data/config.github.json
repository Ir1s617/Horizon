{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.3,
    "max_tokens": 4096,
    "languages": ["zh"],
    "throttle_sec": 1,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },

  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },

  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 10,
      "min_score": 50,
      "profile": "tech-news"
    }
  },

  "collection": {
    "time_window_hours": 24
  },

  "digest": {
    "max_items": 8,
    "profile_order": ["tech-news"]
  }
}
